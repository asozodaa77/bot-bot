:root{
  --bg:var(--tg-theme-bg-color,#f6f8f8);--fg:var(--tg-theme-text-color,#12202b);
  --hint:var(--tg-theme-hint-color,#6b7c88);--card:var(--tg-theme-secondary-bg-color,#fff);
  --jade:#0e8f7e;--lacquer:#c4372f;--gold:#d9a62e;--line:rgba(127,140,150,.22);
}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
body{background:var(--bg);color:var(--fg);font:16px/1.45 -apple-system,"Segoe UI",Roboto,sans-serif;
  padding:0 16px calc(84px + env(safe-area-inset-bottom,0px))}
h1{font-size:24px;margin:20px 0 4px}h2{font-size:18px;margin:22px 0 10px}
p.sub{color:var(--hint);font-size:14px}
.hz{font-family:"Noto Serif SC",serif;font-weight:900}
.hero{margin-top:16px;border-radius:20px;padding:20px;color:#fff;position:relative;overflow:hidden;
  background:linear-gradient(135deg,#0b6f63,#0e8f7e)}
.hero .big{position:absolute;right:10px;top:-14px;font-size:120px;opacity:.18;line-height:1}
.bar{height:8px;border-radius:8px;background:rgba(255,255,255,.28);margin-top:14px}
.bar b{display:block;height:100%;border-radius:8px;background:#fff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tile{background:var(--card);border-radius:16px;padding:16px;border:1px solid var(--line);text-align:left;
  color:var(--fg);font:inherit;font-weight:600;display:flex;flex-direction:column;gap:6px}
.tile i{font-style:normal;font-size:26px}.tile small{font-weight:400;color:var(--hint)}
.vip-banner{margin-top:12px;width:100%;border:0;border-radius:16px;padding:16px;text-align:left;font:inherit;
  color:#2b1d00;background:linear-gradient(120deg,#f3cf6a,#d9a62e);font-weight:700}
.vip-banner small{display:block;font-weight:500;opacity:.8}
.lesson{display:flex;gap:14px;align-items:center;background:var(--card);border:1px solid var(--line);
  border-radius:16px;padding:10px;margin-bottom:10px;width:100%;color:var(--fg);font:inherit;text-align:left}
.cover{flex:none;width:64px;height:84px;border-radius:8px 12px 12px 8px;color:#fff;display:grid;place-items:center;
  font-size:30px;border-left:5px solid rgba(0,0,0,.25);background-size:cover;background-position:center}
.c1{background:url(img/hsk1.jpg),linear-gradient(160deg,#0e8f7e,#075c52)}
.c2{background:url(img/hsk2.jpg),linear-gradient(160deg,#3a6fd8,#1d3f8f)}
.c3{background:url(img/hsk3.jpg),linear-gradient(160deg,#c4372f,#7d1a15)}
.lesson b{display:block}.lesson small{color:var(--hint)}
.tag{margin-left:auto;font-size:12px;font-weight:700;padding:3px 9px;border-radius:20px;background:var(--line)}
.tag.vip{background:var(--gold);color:#2b1d00}.tag.ok{background:var(--jade);color:#fff}
.word{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-bottom:10px;
  display:flex;align-items:center;gap:14px}
.word .hz{font-size:34px;min-width:76px;color:var(--lacquer)}
.word .py{font-weight:700;color:var(--jade)}.word .say{font-size:13px;color:var(--hint)}
.spk{margin-left:auto;border:0;border-radius:50%;width:42px;height:42px;background:var(--jade);color:#fff;font-size:18px}
.btn{width:100%;border:0;border-radius:14px;padding:14px;font:inherit;font-weight:700;color:#fff;background:var(--jade);margin-top:8px}
.btn.alt{background:var(--card);color:var(--fg);border:1px solid var(--line)}
.back{border:0;background:none;color:var(--jade);font:inherit;font-weight:600;margin-top:16px;padding:0}
.chips{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.chip{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 0;text-align:center;color:var(--fg);font:inherit}
.chip b{font-size:20px;color:var(--lacquer)}.chip small{display:block;color:var(--hint);font-size:12px}
.tone{background:var(--card);border-radius:14px;border:1px solid var(--line);padding:12px 14px;margin-bottom:8px;display:flex;gap:12px;align-items:center}
.tone .hz{font-size:28px;color:var(--lacquer)}
.q{font-size:64px;text-align:center;margin:26px 0 4px;color:var(--lacquer)}
.opt{display:block;width:100%;text-align:left;border:1px solid var(--line);background:var(--card);color:var(--fg);
  border-radius:14px;padding:14px;margin-top:8px;font:inherit}
.opt.good{background:var(--jade);color:#fff}.opt.bad{background:var(--lacquer);color:#fff}
.plan{background:var(--card);border:2px solid var(--line);border-radius:18px;padding:16px;margin-bottom:12px}
.plan.best{border-color:var(--gold)}.plan .price{font-size:26px;font-weight:800}
.plan ul{margin:8px 0 0 18px;color:var(--hint);font-size:14px}
.search{width:100%;padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:var(--card);color:var(--fg);font:inherit;margin:14px 0 6px}
nav{position:fixed;left:0;right:0;bottom:0;display:flex;background:var(--card);border-top:1px solid var(--line);
  padding:6px 4px calc(6px + env(safe-area-inset-bottom,0px))}
nav button{flex:1;border:0;background:none;color:var(--hint);font:inherit;font-size:11px;display:flex;flex-direction:column;align-items:center;gap:2px}
nav button i{font-style:normal;font-size:20px}nav button.on{color:var(--jade);font-weight:700}
@media (prefers-reduced-motion:no-preference){.hero .big{animation:fl 6s ease-in-out infinite alternate}}
@keyframes fl{to{transform:translateY(8px)}}
button:focus-visible{outline:2px solid var(--jade);outline-offset:2px}
